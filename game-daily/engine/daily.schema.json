{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local/game-daily/daily.schema.json",
  "title": "game-daily daily-routine file",
  "description": "一个游戏的日常流程定义：顺序步骤、每步的认屏条件、动作与复检条件。",
  "type": "object",
  "required": ["game", "steps"],
  "properties": {
    "game": { "type": "string" },
    "version": { "type": "integer", "const": 1 },
    "base": {
      "type": "object",
      "required": ["w", "h"],
      "properties": {
        "w": { "type": "integer" },
        "h": { "type": "integer" }
      }
    },
    "notes": { "type": "string" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "actions"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" },
          "expect": {
            "type": "object",
            "description": "对当前界面的识别条件；all 全命中才算进入本步界面",
            "properties": {
              "all": { "type": "array", "items": { "type": "string" } },
              "any": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["do"],
              "properties": {
                "do": { "enum": ["click", "move", "key", "wait", "shot", "fg"] },
                "coord": { "type": "string", "description": "坐标 id，需存在于 coords 文件" },
                "x": { "type": "integer" },
                "y": { "type": "integer" },
                "vk": { "type": "integer", "minimum": 1, "maximum": 255 },
                "ms": { "type": "integer", "minimum": 0 },
                "name": { "type": "string" },
                "target": { "enum": ["game", "launcher"] }
              },
              "additionalProperties": false
            }
          },
          "verify": {
            "type": "object",
            "description": "执行后的复检条件；any 命中任一即通过",
            "properties": {
              "all": { "type": "array", "items": { "type": "string" } },
              "any": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          },
          "onMismatch": { "enum": ["stop", "skip", "retry1"], "default": "stop" },
          "optional": { "type": "boolean", "default": false },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
