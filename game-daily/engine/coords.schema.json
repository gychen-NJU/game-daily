{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local/game-daily/coords.schema.json",
  "title": "game-daily coords file",
  "description": "模块内的默认坐标表。坐标以相对值（rx,ry ∈ [0,1]）为准，absolute 仅作为出厂机器上的参考。",
  "type": "object",
  "required": ["base", "items"],
  "properties": {
    "game": { "type": "string", "description": "模块代码：sr / zzz / hi / gi" },
    "version": { "type": "integer", "const": 1 },
    "base": {
      "type": "object",
      "description": "录制默认坐标时的屏幕物理尺寸",
      "required": ["w", "h"],
      "properties": {
        "w": { "type": "integer", "minimum": 320 },
        "h": { "type": "integer", "minimum": 240 }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "relative"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
          "absolute": {
            "type": "object",
            "properties": {
              "x": { "type": "integer", "minimum": 0 },
              "y": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "relative": {
            "type": "object",
            "required": ["rx", "ry"],
            "properties": {
              "rx": { "type": "number", "minimum": 0, "maximum": 1 },
              "ry": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          },
          "desc": { "type": "string" },
          "note": { "type": "string", "description": "易错点 / 记录条件" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
